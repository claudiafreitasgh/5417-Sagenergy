@model IEnumerable<_5417_Sagenergy.Data.Entities.Service>

@{
    ViewData["Title"] = "Services";
}

<h1>Services</h1>

@* Permite criar um novo serviço *@
<p>
    <a asp-action="Create" class="btn btn-primary">
        Create New
    </a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Service Type</th>
            <th>Active</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@item.Price</td>
                <td>@item.ServiceType</td>
                <td>@item.IsActive</td>

                <td>
                    @* Permite consultar os detalhes do serviço *@
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">
                        Details
                    </a>

                    @* Permite editar o serviço *@
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                        Edit
                    </a>

                    @* Permite eliminar o serviço *@
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
