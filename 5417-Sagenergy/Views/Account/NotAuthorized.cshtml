@{
    ViewData["Title"] = "Not Authorized";
}

<div class="error-403">

    <svg xmlns="http://www.w3.org/2000/svg"
         id="robot-error"
         viewBox="0 0 260 118.9"
         role="img">

        <title>403 Error</title>

        <defs>

            <clipPath id="white-clip">
                <circle fill="#cacaca"
                        cx="130"
                        cy="65"
                        r="20" />
            </clipPath>

            <text id="text-s"
                  class="error-text"
                  y="106">
                403
            </text>

        </defs>

        <path class="alarm"
              fill="#e62326"
              d="M120.9 19.6V9.1c0-5 4.1-9.1 9.1-9.1h0c5 0 9.1 4.1 9.1 9.1v10.6" />

        <use href="#text-s"
             x="-0.5px"
             y="-1px"
             fill="black">
        </use>

        <use href="#text-s"
             fill="#2b2b2b">
        </use>

        <g id="robot">

            <g id="eye-wrap">

                <use href="#white-clip"></use>

                <circle class="eye"
                        clip-path="url(#white-clip)"
                        fill="#000"
                        stroke="#2aa7cc"
                        stroke-width="2"
                        stroke-miterlimit="10"
                        cx="130"
                        cy="65"
                        r="11" />

                <ellipse fill="#2b2b2b"
                         cx="130"
                         cy="40"
                         rx="18"
                         ry="12" />

            </g>

            <circle class="lightblue"
                    cx="105"
                    cy="32"
                    r="2.5" />

            <circle class="lightblue"
                    cx="155"
                    cy="32"
                    r="2.5" />

            <circle class="lightblue"
                    cx="155"
                    cy="92"
                    r="2.5" />

            <circle class="lightblue"
                    cx="105"
                    cy="92"
                    r="2.5" />

        </g>

    </svg>

  

    <h2 class="h2-forbidden">
        Não está autorizado a executar esta ação!
    </h2>

    <p class="back-home">
        <a href="/">Voltar à página inicial</a>
    </p>

</div>